export {chuiyi}

@Component
struct chuiyi{
  //单个图片
  @Builder
  jujian(img:ResourceStr,data:string,huo:number){
    Stack({alignContent:Alignment.Bottom}){
      Image(img)
        .width("100%")
        .height(100)
        .borderRadius(15)
      Row(){
        Text("回放")
          .fontColor('#0E0C0C')
          .fontSize(12)
        Text(data)
          .fontColor('#0E0C0C')
          .fontSize(12)
        Row(){
          Image($r('app.media.huohua'))
            .width(15)

          Text(`${huo}w`)
            .fontColor('#0E0C0C')
            .fontSize(12)
        }
      }.width("100%")
      .borderRadius({bottomLeft:15,bottomRight:15})
      .justifyContent(FlexAlign.SpaceBetween)
      .backgroundColor("#F4F4F4")
      .padding({left:5,right:5,top:3,bottom:3})
    }
  }
  build() {
    Column(){
      //头行
      Row(){
        Row(){
          Text("3C会议")
            .fontColor(Color.White)
          Image($r('app.media.zhuanfa'))
            .width(25)
            .padding({left:10})
        }
        Row(){
          Image($r('app.media.fanhui'))
            .width(15)
        }
      }.width("95%")
      .justifyContent(FlexAlign.SpaceBetween)
      //轮播图
      Swiper(){
        //1
        Column(){
          //1-1
          Row(){
            Row(){
              this.jujian($r('app.media.1_4_1'),'12-01',4.1)
            }.width("50%")
            .padding({right:5})
            Row(){
              this.jujian($r('app.media.1_4_2'),'12-01',10)
            }.width("50%")
          }.padding({bottom:5})
          //1-2
          Row(){
            Row(){
              this.jujian($r('app.media.1_4_3'),'12-01',6.6)
            }.width("50%")
            .padding({right:5})
            Row(){
              this.jujian($r('app.media.1_4_4'),'12-01',12)
            }.width("50%")
          }.padding({bottom:25})
        }.width("90%")
        //2
        Column(){
          //2-1
          Row(){
            Row(){
              this.jujian($r('app.media.1_4_5'),'12-01',8.9)
            }.width("50%")
            .padding({right:5})
            Row(){
              this.jujian($r('app.media.1_4_6'),'12-01',7.6)
            }.width("50%")
          }.padding({bottom:5})
          //2-2
          Row(){
            Row(){
              this.jujian($r('app.media.1_4_7'),'12-01',14)
            }.width("50%")
            .padding({right:5})
            Row(){
              this.jujian($r('app.media.1_4_8'),'12-01',3)
            }.width("50%")
          }.padding({bottom:25})
        }.width("95%")
      }.padding({top:10})
    }.width("100%")

  }

}