    Column(){
      //头行
      Row(){
        Row(){
          Text("热门股票")
            .fontColor(Color.White)
          Image($r('app.media.zhuanfa'))
            .width(25)
            .padding({left:10})
        }
        Row(){
          Image($r('app.media.fanhui'))
            .width(15)
        }
      }
      .width("95%")
      .justifyContent(FlexAlign.SpaceBetween)

      Column(){
        //1-1
        Row(){
          //1-1-1
          Row(){
            this.zujian(0,"#FB0610","#FB0610")
          }.layoutWeight(2)
          .justifyContent(FlexAlign.Center)
          .margin({left:5})
          .backgroundColor('#1C1C1C')
          //1-1-2
          Row(){
            this.zujian(1,"#FB0610","#FB0610")
          }.layoutWeight(2)
          .justifyContent(FlexAlign.Center)
          .margin({left:5,right:5})
          .backgroundColor('#1C1C1C')
          //1-1-2
          Row(){
            this.zujian(2,"#FB0610","#FB0610")
          }.layoutWeight(2)
          .justifyContent(FlexAlign.Center)
          .margin({right:5})
          .backgroundColor('#1C1C1C')
        }.margin({bottom:5})
        //1-2
        Row(){
          //1-2-1
          Row(){
            this.zujian(3,"#0AF650","#0AF650")
          }.layoutWeight(2)
          .justifyContent(FlexAlign.Center)
          .margin({left:5})
          .backgroundColor('#1C1C1C')
          //1-2-1
          Row(){
            this.zujian(4,"#FB0610","#FB0610")
          }.layoutWeight(2)
          .justifyContent(FlexAlign.Center)
          .margin({left:5,right:5})
          .backgroundColor('#1C1C1C')
          //1-2-1
          Row(){
            this.zujian(5,"#0AF650","#0AF650")
          }.layoutWeight(2)
          .justifyContent(FlexAlign.Center)
          .margin({right:5})
          .backgroundColor('#1C1C1C')
        }.margin({bottom:5})
        //1-3
        Row(){
          //1-3-1
          Row(){
            this.zujian(6,"#FB0610","#FB0610")
          }.layoutWeight(2)
          .justifyContent(FlexAlign.Center)
          .margin({left:5})
          .backgroundColor('#1C1C1C')
          //1-3-2
          Row(){
            this.zujian(7,"#0AF650","#0AF650")
          }.layoutWeight(2)
          .justifyContent(FlexAlign.Center)
          .margin({left:5,right:5})
          .backgroundColor('#1C1C1C')
          //1-3-3
          Row(){
            this.zujian(8,"#FB0610","#FB0610")
          }.layoutWeight(2)
          .justifyContent(FlexAlign.Center)
          .margin({right:5})
